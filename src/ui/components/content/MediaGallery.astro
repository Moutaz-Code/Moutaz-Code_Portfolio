---
import ResponsiveImage from "./ResponsiveImage.astro";

interface MediaItem {
  type?: "image" | "gif" | "video";
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
const single = items.length === 1;
const mediaClass = "rounded-lg border border-(--color-border) w-full";
---

<div class:list={[!single && "grid gap-4 sm:grid-cols-2"]}>
  {items.map((item) => (
    <figure class="m-0">
      {item.type === "video" ? (
        <video
          src={item.src}
          class={mediaClass}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={item.alt || undefined}
        />
      ) : (
        <ResponsiveImage
          src={item.src}
          alt={item.alt ?? ""}
          variant="gallery"
          class={mediaClass}
        />
      )}
      {item.caption && (
        <figcaption
          class:list={[
            "text-(--color-text-muted) text-center",
            single ? "mt-2 text-sm" : "mt-1 text-xs",
          ]}
        >
          {item.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
