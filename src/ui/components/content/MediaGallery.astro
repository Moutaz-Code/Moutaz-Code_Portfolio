---
import ResponsiveImage from "./ResponsiveImage.astro";

interface MediaItem {
  type?: "image" | "gif" | "video";
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
const single = items.length === 1;
const mediaClass = "gallery-media";
---

<div class:list={["gallery", single && "single"]}>
  {items.map((item, i) => (
    <figure class:list={[i === 0 && items.length > 2 && "lead"]}>
      {item.type === "video" ? (
        <video
          src={item.src}
          class={mediaClass}
          muted
          loop
          playsinline
          preload="metadata"
          data-gallery-video
          aria-label={item.alt || undefined}
        />
      ) : (
        <ResponsiveImage
          src={item.src}
          alt={item.alt ?? ""}
          variant="gallery"
          class={mediaClass}
        />
      )}
      {item.caption && (
        <figcaption>
          {item.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .gallery.single { grid-template-columns: minmax(0, 1fr); }
  figure { margin: 0; min-width: 0; }
  figure.lead { grid-column: 1 / -1; }
  .gallery :global(.gallery-media) { display: block; width: 100%; height: auto; border-radius: var(--r); border: 1px solid var(--line); background: var(--panel-2); }
  .gallery :global(video.gallery-media) { aspect-ratio: 16 / 9; object-fit: cover; }
  .gallery:not(.single) figure:not(.lead) :global(img.gallery-media) { aspect-ratio: 16 / 9; object-fit: contain; }
  figcaption { margin-top: 0.4rem; color: var(--faint); font-size: 0.85rem; }
  @media (max-width: 640px) { .gallery { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  // Gallery clips play only while on screen, and never on their own when the
  // visitor prefers reduced motion (they get native controls instead).
  import { prefersReducedMotion } from "../../runtime/prefs";

  const videos = document.querySelectorAll<HTMLVideoElement>("video[data-gallery-video]");

  if (prefersReducedMotion()) {
    videos.forEach((v) => (v.controls = true));
  } else if (videos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement;
          if (isIntersecting) v.play().catch(() => (v.controls = true));
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
