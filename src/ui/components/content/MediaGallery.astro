---
import ResponsiveImage from "./ResponsiveImage.astro";

interface MediaItem {
  type?: "image" | "gif" | "video";
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
const single = items.length === 1;
const mediaClass = "rounded-lg border border-(--color-border) w-full";
---

<div class:list={[!single && "grid gap-4 sm:grid-cols-2"]}>
  {items.map((item) => (
    <figure class="m-0">
      {item.type === "video" ? (
        <video
          src={item.src}
          class={mediaClass}
          muted
          loop
          playsinline
          preload="metadata"
          data-gallery-video
          aria-label={item.alt || undefined}
        />
      ) : (
        <ResponsiveImage
          src={item.src}
          alt={item.alt ?? ""}
          variant="gallery"
          class={mediaClass}
        />
      )}
      {item.caption && (
        <figcaption
          class:list={[
            "text-(--color-text-muted) text-center",
            single ? "mt-2 text-sm" : "mt-1 text-xs",
          ]}
        >
          {item.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<script>
  // Gallery clips play only while on screen, and never on their own when the
  // visitor prefers reduced motion (they get native controls instead).
  import { prefersReducedMotion } from "../../runtime/prefs";

  const videos = document.querySelectorAll<HTMLVideoElement>("video[data-gallery-video]");

  if (prefersReducedMotion()) {
    videos.forEach((v) => (v.controls = true));
  } else if (videos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement;
          if (isIntersecting) v.play().catch(() => (v.controls = true));
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
