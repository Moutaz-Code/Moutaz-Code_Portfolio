---
import "../../styles/global.css";
import { siteConfig } from "../../app/siteConfig";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noIndex?: boolean;
}

const {
  title,
  description = `${siteConfig.siteName}, ${siteConfig.siteTagline.toLowerCase()} based in Abu Dhabi.`,
  ogImage,
  ogType = "website",
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.siteName}` : `${siteConfig.siteName} | ${siteConfig.siteTagline}`;
const siteBase = Astro.site?.href ?? siteConfig.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).href;
const resolvedOgImage = new URL(ogImage ?? siteConfig.defaultOgImage, siteBase).href;
const isHome = Astro.url.pathname === "/";
const links = siteConfig.socialLinks;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,300..600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${siteConfig.siteName}, home`}>
          <span class="mark" aria-hidden="true">MP</span>
          <span class="name">{siteConfig.siteName}</span>
        </a>
        <nav aria-label="Main">
          {siteConfig.navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/projects" class="all" aria-current={Astro.url.pathname.startsWith("/projects") ? "page" : undefined}>All projects</a>
          <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
            <span class="when-dark">Light</span><span class="when-light">Dark</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p class="mono">© {new Date().getFullYear()} {siteConfig.siteName}</p>
        <p class="foot-links">
          <a href={links.github} rel="noreferrer">GitHub</a>
          <a href={links.linkedin} rel="noreferrer">LinkedIn</a>
          <a href={links.itch} rel="noreferrer">itch.io</a>
          <a href={links.shadertoy} rel="noreferrer">Shadertoy</a>
          {!isHome && <a href="/#contact">Contact</a>}
        </p>
      </div>
    </footer>

    <SpeedInsights />
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
        });
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 60; background: var(--accent); color: var(--accent-ink); padding: 0.5rem 0.8rem; border-radius: var(--r); }
  .skip:focus { left: 12px; }
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top, 0px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 0.7rem; color: var(--text); text-decoration: none; }
  .mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 5px; border: 1.5px solid var(--accent); color: var(--accent); font: 800 0.8rem/1 var(--display); font-stretch: 125%; letter-spacing: 0.02em; }
  .name { font: 750 1.02rem/1 var(--display); font-stretch: 115%; }
  nav { display: flex; align-items: center; gap: 0.15rem; }
  nav a { padding: 0.55rem 0.7rem; color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.92rem; border-radius: var(--r); }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); }
  nav .all { color: var(--text); border: 1px solid var(--line-2); margin-left: 0.35rem; }
  .theme { margin-left: 0.35rem; min-height: 38px; padding: 0 0.7rem; border-radius: var(--r); border: 1px solid var(--line); background: transparent; color: var(--muted); font: 500 0.7rem/1 var(--mono); font-stretch: 87.5%; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; }
  .theme:hover { color: var(--text); border-color: var(--line-2); }
  :global([data-theme="light"]) .when-dark, :global([data-theme="dark"]) .when-light { display: none; }
  @media (max-width: 760px) {
    .bar { flex-wrap: wrap; padding-block: 0.6rem; min-height: 0; }
    .name { display: none; }
    nav { flex: 1; justify-content: flex-end; flex-wrap: wrap; }
    nav a { padding: 0.5rem 0.45rem; font-size: 0.86rem; }
    nav a[href="/#contact"] { display: none; }
  }
  @media (max-width: 420px) { nav a[href="/#shaders"] { display: none; } }
  .site-footer { border-top: 1px solid var(--line); margin-top: 2rem; padding-bottom: env(safe-area-inset-bottom, 0px); }
  .foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-block: 2rem; color: var(--faint); }
  .foot-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .foot-links a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .foot-links a:hover { color: var(--text); }
</style>
