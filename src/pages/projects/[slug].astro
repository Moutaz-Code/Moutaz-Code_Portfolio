---
import { contentSource } from "../../app/content";
import BaseLayout from "../../ui/layouts/BaseLayout.astro";
import MediaGallery from "../../ui/components/content/MediaGallery.astro";
import Prose from "../../ui/components/content/Prose.astro";
import ItchEmbed from "../../ui/components/integrations/ItchEmbed.astro";
import ShaderToyEmbed from "../../ui/components/integrations/ShaderToyEmbed.astro";
import { tagLabel } from "../../domain/rules/tags";

export async function getStaticPaths() {
  const projects = await contentSource.listProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = await contentSource.getProjectBySlug(slug!);
if (!project) return Astro.redirect("/404");

const { title, summary, tags, links, media, content, role, team, timeframe, stack, githubRepo, itchEmbedUrl, shaderToyId, category, kind, award, highlights, wip } = project;
const { Content } = content;

const all = await contentSource.listProjects();
const i = all.findIndex((p) => p.slug === slug);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const allLinks = [...links, ...(githubRepo ? [{ label: "Source on GitHub", url: `https://github.com/${githubRepo}` }] : [])];
---

<BaseLayout title={title} description={summary} ogImage={project.primaryImage?.src} ogType="article">
  <article class="wrap page">
    <a class="back mono" href="/projects">← All projects</a>

    <header class="head">
      <p class="cat"><span class="pip" style={`background: var(--${category.toLowerCase()})`}></span>{category}{kind && ` · ${kind}`}</p>
      <h1>{title}</h1>
      {(award || wip) && <p class="badges">{award && <span class="award">{award}</span>}{wip && <span class="wip">Under construction</span>}</p>}
      <p class="sum">{summary}</p>
    </header>

    <dl class="facts">
      {role && <div><dt class="label">Role</dt><dd>{role}</dd></div>}
      {team && <div><dt class="label">Team</dt><dd>{team}</dd></div>}
      {timeframe && <div><dt class="label">When</dt><dd>{timeframe}</dd></div>}
      {stack.length > 0 && <div class="wide"><dt class="label">Stack</dt><dd>{stack.join(", ")}</dd></div>}
    </dl>
    {allLinks.length > 0 && (
      <p class="links">{allLinks.map((l, k) => <a class:list={["btn", k === 0 && "btn-primary"]} href={l.url} rel="noreferrer">{l.label}</a>)}</p>
    )}

    {media.length > 0 && <div class="media"><MediaGallery items={media} /></div>}

    <div class="body">
      <div class="main">
        {itchEmbedUrl && <ItchEmbed src={itchEmbedUrl} title={`${title} on itch.io`} />}
        {shaderToyId && <ShaderToyEmbed shaderId={shaderToyId} title={`${title} on Shadertoy`} />}
        <Prose><Content /></Prose>
      </div>
      <aside class="aside">
        {highlights.length > 0 && (
          <div class="box">
            <p class="label">What I did</p>
            <ul class="hl">{highlights.map((h) => <li>{h}</li>)}</ul>
          </div>
        )}
        {tags.length > 0 && (
          <div class="box">
            <p class="label">Tags</p>
            <p class="tags">{tags.map((t) => <a class="tag" href={`/projects?tag=${t}`}>{tagLabel(t)}</a>)}</p>
          </div>
        )}
      </aside>
    </div>

    <nav class="pager" aria-label="More projects">
      <a href={`/projects/${prev.slug}`}><span class="label">Previous</span><span class="t">{prev.title}</span></a>
      <a href={`/projects/${next.slug}`} class="nx"><span class="label">Next</span><span class="t">{next.title}</span></a>
    </nav>
  </article>
</BaseLayout>

<style>
  .page { padding-block: 2.5rem 3rem; }
  .back { color: var(--muted); text-decoration: none; display: inline-block; margin-bottom: 2.25rem; }
  .back:hover { color: var(--text); }
  .head { display: flex; flex-direction: column; gap: 0.9rem; max-width: 52rem; }
  .cat { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--muted); font: 500 0.72rem/1 var(--mono); font-stretch: 87.5%; text-transform: uppercase; letter-spacing: 0.04em; }
  .pip { display: inline-block; width: 9px; height: 9px; border-radius: 2px; }
  h1 { font-size: clamp(2.3rem, 6vw, 4rem); font-stretch: 118%; font-weight: 800; line-height: 1; letter-spacing: -0.025em; }
  .badges { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sum { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 2rem 0 0; padding: 1.1rem 0; border-block: 1px solid var(--line); }
  .facts dd { margin: 0.3rem 0 0; font-size: 0.95rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .media { margin-top: 2.25rem; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 2rem 4rem; margin-top: 3rem; }
  .aside { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 88px; align-self: start; }
  .box { padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--panel); display: flex; flex-direction: column; gap: 0.7rem; }
  .hl { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.92rem; }
  .hl li { padding-left: 1rem; position: relative; line-height: 1.45; }
  .hl li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; background: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag { padding: 0.3rem 0.55rem; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); text-decoration: none; font: 500 0.68rem/1.2 var(--mono); font-stretch: 87.5%; }
  .tag:hover { color: var(--text); border-color: var(--line-2); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); text-decoration: none; color: var(--text); }
  .pager a:hover { border-color: var(--line-2); background: var(--panel); }
  .pager .nx { text-align: right; align-items: flex-end; }
  .pager .t { font: 700 1.1rem/1.2 var(--display); font-stretch: 110%; }
  @media (max-width: 900px) {
    .body { grid-template-columns: minmax(0, 1fr); }
    .aside { position: static; order: -1; }
  }
  @media (max-width: 520px) { .pager { grid-template-columns: 1fr; } .pager .nx { text-align: left; align-items: flex-start; } }
</style>
