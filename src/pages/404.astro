---
import BaseLayout from "../ui/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noIndex={true}>
  <section class="wrap nf">
    <p class="label">404</p>
    <h1>Nothing rendered here.</h1>
    <p class="muted">The page may have moved when the site was rebuilt.</p>
    <p class="ctas"><a class="btn btn-primary" href="/">Home</a><a class="btn" href="/projects">All projects</a></p>
  </section>
</BaseLayout>

<style>
  .nf { display: flex; flex-direction: column; gap: 1rem; padding-block: 7rem 6rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); font-stretch: 118%; font-weight: 800; }
  .ctas { display: flex; gap: 0.6rem; margin-top: 0.6rem; }
</style>
