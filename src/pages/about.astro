---
import BaseLayout from "../ui/layouts/BaseLayout.astro";
import PageHeader from "../ui/components/primitives/PageHeader.astro";
import SignatureInit from "../ui/components/signature/SignatureInit.astro";
---

<BaseLayout
  title="About"
  description="A bit about who I am, what I do, and what I'm interested in."
  enableSmoothScroll
  enableAmbient
  enableCursor
  enablePageTransitions
  enableSound
>
  <section class="py-8">
    <PageHeader title="About Me" subtitle="A bit about who I am, what I do, and what I'm interested in." enableSignature />

    <div class="space-y-10">
      <!-- What I Do -->
      <div>
        <h2 class="text-xl font-semibold mb-3">What I Do</h2>
        <p class="max-w-2xl text-(--color-text-muted) leading-relaxed">
          I'm a game developer from Abu Dhabi, and I've been making games for over
          three years, mostly in Unity. I'm a programmer first, but the part I
          enjoy most is rendering: writing shaders, building post-processing
          stacks, lighting scenes and giving a game a look of its own. When a jam
          needs it, I'll model the props too.
        </p>
      </div>

      <!-- What I'm Interested In -->
      <div>
        <h2 class="text-xl font-semibold mb-3">What I'm Interested In</h2>
        <p class="max-w-2xl text-(--color-text-muted) leading-relaxed">
          Real-time rendering and stylised looks: dithering, outlines,
          posterisation, PSX-era graphics, procedural skies. Lately I've been
          digging into physically based sky rendering and how to make it cheap
          enough for URP, and building Bezium, a vector-graphics toolkit for
          Unity that renders to world-space meshes.
        </p>
      </div>

      <!-- Toolbox -->
      <div>
        <h2 class="text-xl font-semibold mb-3">Toolbox</h2>
        <div class="flex gap-2 flex-wrap">
          {
            [
              "Unity",
              "URP",
              "HDRP",
              "C#",
              "HLSL",
              "GLSL",
              "Shader Graph",
              "Render Graph",
              "C++",
              "Godot",
              "Blender",
              "Git",
            ].map((tool) => (
              <span class="inline-block rounded-full border border-(--color-border) px-3 py-1 text-xs font-medium text-(--color-text-muted)">
                {tool}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Currently -->
      <div
        class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-5"
      >
        <h2 class="text-lg font-semibold mb-2">Currently</h2>
        <ul class="space-y-1 text-sm text-(--color-text-muted)">
          <li>Mentoring game-development students at Endless Studios</li>
          <li>Building Bezium, a vector-graphics toolkit for Unity</li>
          <li>Researching a physically based sky for URP</li>
        </ul>
      </div>
    </div>
  </section>
  <SignatureInit />
</BaseLayout>
